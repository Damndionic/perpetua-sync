<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console program, so the tests need no NuGet packages either: dotnet run -project tests/PerpetuaSync.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PerpetuaSync.Core/PerpetuaSync.Core.csproj" />
  </ItemGroup>
</Project>
